{
  "name": "open-live-bar",
  "private": true,
  "version": "0.1.0",
  "description": "Platform-agnostic interactive live stream game engine",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "test": "node --import tsx --test packages/**/*.test.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "start:server": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
